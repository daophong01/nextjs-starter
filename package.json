    "stripe": "^16.7.0",
    "resend": "^4.0.0",
    "next-auth": "^4.24.7",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@heroicons/react": "^2.1.5",
    "@upstash/ratelimit": "^1.0.6",
    "@upstash/redis": "^1.33.0",
    "@sentry/nextjs": "^8.33.1",
    "bcryptjs": "^2.4.3",
    "@react-email/components": "^0.0.23",
    "@react-email/render": "^0.0.17",
